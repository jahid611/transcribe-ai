# =========================================================================
# transcribe-ai — environment variables template
# Copier en .env.local et remplir.
# =========================================================================

# ---- Mode -----------------------------------------------------------------
# STUB=true : tous les providers (LLM, Stripe, Clerk) renvoient des stubs.
# Permet de lancer pnpm dev sans aucune clé pour démo locale.
STUB=false

# ---- App URLs -------------------------------------------------------------
APP_URL=http://localhost:3000
API_URL=http://localhost:8787
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8787

# ---- Clerk (Auth) — https://dashboard.clerk.com -------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx
CLERK_JWT_KEY=

# ---- Turso (libSQL) — https://turso.tech --------------------------------
# Local dev : file:./local.db (par défaut, créée auto)
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# ---- LLM providers (pay-as-you-go uniquement, cf. docs/llm/STRATEGY.md) --
# Primary
GROQ_API_KEY=gsk_xxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback 1
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Fallback 2 (Emergency)
TOGETHER_API_KEY=xxxxxxxxxxxx
TOGETHER_MODEL=mistralai/Mixtral-8x22B-Instruct-v0.1

LLM_PRIMARY=groq
LLM_FALLBACK=openrouter
LLM_EMERGENCY=together

# ---- QStash (async jobs) — https://upstash.com/qstash --------------------
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ---- Stripe (payments) — https://dashboard.stripe.com -------------------
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_PRICE_PRO_MONTHLY=price_xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
